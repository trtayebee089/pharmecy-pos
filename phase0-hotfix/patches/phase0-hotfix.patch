diff --git a/.htaccess b/.htaccess
index ad30d1d..cd80f26 100644
--- a/.htaccess
+++ b/.htaccess
@@ -5,6 +5,25 @@
 
 RewriteEngine On
 
+# ---- PHASE 0 HOTFIX (security) ----------------------------------------------
+# Applies when the web root is the Laravel project root instead of public/.
+# Dotfiles (.env, .git ...) except ACME/SSL validation
+RewriteRule (^|/)\.(?!well-known/) - [F,L]
+# Database dumps, archives, logs, backups anywhere
+RewriteRule \.(sql|sql\.gz|zip|rar|7z|tar|tgz|gz|bak|old|log)$ - [F,NC,L]
+# Framework internals that must never be reachable over HTTP
+RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|track|Modules|node_modules|storage/(app|framework|logs|debugbar))(/|$) - [F,NC,L]
+RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml.*|webpack\.mix\.js|modules_statuses\.json|word\ list\.txt|find_untranslated\.php|README\.md)$ - [F,NC,L]
+# Direct requests for PHP files other than the front controllers or public/
+# (THE_REQUEST is the original request line, so internal rewrites to
+# server.php are not affected)
+RewriteCond %{THE_REQUEST} \s/+(?!public/|index\.php|server\.php)[^?\s]*\.(php[0-9]?|phtml|phar)[\s?/] [NC]
+RewriteRule ^ - [F,L]
+# Vendor installer / debug leftovers and script execution in upload folders
+RewriteRule ^(public/)?(delete\.php|debug_[^/]*\.txt|phpinfo\.php|info\.php)$ - [F,NC,L]
+RewriteRule ^(public/)?(images|documents|downloads|product|purchase|sale|stock_count|transfer|data|prescriptions|storage|img|logo|icons|sample_file)/.*\.(php[0-9]?|phtml|phar|pht|cgi|pl|py|sh)$ - [F,NC,L]
+# -----------------------------------------------------------------------------
+
 RewriteCond %{REQUEST_FILENAME} -d [OR]
 RewriteCond %{REQUEST_FILENAME} -f
 RewriteRule ^ ^$1 [N]
