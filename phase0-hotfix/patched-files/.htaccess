<IfModule mod_rewrite.c>
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

RewriteEngine On

# ---- PHASE 0 HOTFIX (security) ----------------------------------------------
# Applies when the web root is the Laravel project root instead of public/.
# Dotfiles (.env, .git ...) except ACME/SSL validation
RewriteRule (^|/)\.(?!well-known/) - [F,L]
# Database dumps, archives, logs, backups anywhere
RewriteRule \.(sql|sql\.gz|zip|rar|7z|tar|tgz|gz|bak|old|log)$ - [F,NC,L]
# Framework internals that must never be reachable over HTTP
RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|track|Modules|node_modules|storage/(app|framework|logs|debugbar))(/|$) - [F,NC,L]
RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml.*|webpack\.mix\.js|modules_statuses\.json|word\ list\.txt|find_untranslated\.php|README\.md)$ - [F,NC,L]
# Direct requests for PHP files other than the front controllers or public/
# (THE_REQUEST is the original request line, so internal rewrites to
# server.php are not affected)
RewriteCond %{THE_REQUEST} \s/+(?!public/|index\.php|server\.php)[^?\s]*\.(php[0-9]?|phtml|phar)[\s?/] [NC]
RewriteRule ^ - [F,L]
# Vendor installer / debug leftovers and script execution in upload folders
RewriteRule ^(public/)?(delete\.php|debug_[^/]*\.txt|phpinfo\.php|info\.php)$ - [F,NC,L]
RewriteRule ^(public/)?(images|documents|downloads|product|purchase|sale|stock_count|transfer|data|prescriptions|storage|img|logo|icons|sample_file)/.*\.(php[0-9]?|phtml|phar|pht|cgi|pl|py|sh)$ - [F,NC,L]
# -----------------------------------------------------------------------------

RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ ^$1 [N]

RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
RewriteRule ^(.*)$ public/$1

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ server.php
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

 # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Video
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/mpeg "access plus 1 year"

  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # CSS, JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Others
  ExpiresByType application/pdf "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
</IfModule>