# Base URL of the centralized Laravel API (no trailing slash)
NUXT_PUBLIC_API_BASE=https://api.redpharmabd.com/api/pos/v1
# Development only: serve data from app/mocks instead of the API. Must be false in production builds.
NUXT_PUBLIC_USE_MOCKS=true
# While mocks are on, domains served by the real API (auth,catalog,customers,sales,dashboard,purchases,registers)
NUXT_PUBLIC_LIVE_DOMAINS=
