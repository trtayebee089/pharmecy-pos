<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>RedPharma Rider</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>RedPharma Rider</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>comgooglemaps</string>
		<string>https</string>
	</array>

	<!-- Google Maps SDK for iOS key, filled from MAPS_API_KEY in ios/Flutter/Secrets.xcconfig -->
	<key>GMSApiKey</key>
	<string>$(MAPS_API_KEY)</string>

	<!-- Location: shown in the iOS permission prompts -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>RedPharma Rider shows your position on the delivery map and shares it with the pharmacy while you are on duty, so customers can see when their order will arrive.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>While you are on duty, RedPharma Rider keeps sharing your position with the pharmacy even when the app is in the background or the screen is off, so customers see an accurate arrival time. Sharing stops when you go off duty.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>While you are on duty, RedPharma Rider keeps sharing your position with the pharmacy even when the app is in the background, so customers see an accurate arrival time.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
	</array>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
